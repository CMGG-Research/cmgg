---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CollaborationCallout from '../components/CollaborationCallout.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { alumni, currentResearchers, groupHead } from '../data/people';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="People"
  description="Meet Dr. Zahid Ahmed, current CMGG researchers, and alumni in computational mathematics and geodynamics."
  canonicalPath="/people/"
>
  <Breadcrumbs items={[{ label: 'People' }]} />
  <PageHero
    eyebrow="People"
    title="A focused group, growing through research supervision."
    intro="CMGG brings together applied mathematics, numerical modelling, fluid dynamics, and emerging geodynamics research through graduate supervision and collaboration."
    indexLabel="Group head · researchers · alumni"
  />

  <section class="section section--white" id="group-head">
    <div class="container">
      <SectionHeading
        eyebrow="Group head"
        title="Academic leadership in computational mathematics and geodynamics."
      />
      <div class="person-grid person-grid--head">
        <PersonCard person={groupHead} />
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Current researchers"
        title="Graduate research in mantle convection and model verification."
        intro="Temporary local portrait placeholders are used where authorized member photographs have not yet been supplied."
      />
      <div class="person-grid person-grid--current">
        {currentResearchers.map((person) => <PersonCard person={person} />)}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="Alumni"
        title="Completed MS research in fluid and transport modelling."
        intro="Alumni work has examined nanofluid flow, porous media, stretching surfaces, heat transfer, and numerical methods."
      />
      <div class="person-grid">{alumni.map((person) => <PersonCard person={person} />)}</div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container"><CollaborationCallout /></div>
  </section>
</BaseLayout>
