---
import { HIGHLIGHT_INTERVAL_MS, highlights } from '../data/highlights';
import { withBase } from '../lib/paths';
---

<div
  class="hero-carousel"
  data-highlights-carousel
  data-interval={HIGHLIGHT_INTERVAL_MS}
  role="region"
  aria-roledescription="carousel"
  aria-label="Mantle dynamics research images"
>
  <div class="hero-carousel__viewport" aria-live="off">
    {
      highlights.map((highlight, index) => (
        <figure
          class:list={['hero-carousel__slide', { 'is-active': index === 0 }]}
          data-highlight-slide
          id={`highlight-${highlight.id}`}
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${highlights.length}: ${highlight.title}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <img
            src={withBase(highlight.image)}
            width={highlight.imageWidth}
            height={highlight.imageHeight}
            alt={highlight.imageAlt}
            loading="eager"
            decoding={index === 0 ? 'sync' : 'async'}
            fetchpriority={index === 0 ? 'high' : 'low'}
          />
        </figure>
      ))
    }
  </div>

  <div class="hero-carousel__controls" role="group" aria-label="Slider controls">
    <button
      type="button"
      class="carousel-button"
      data-carousel-previous
      aria-label="Show previous image"
    >
      <span aria-hidden="true">←</span>
    </button>
    <div class="carousel-dots" role="group" aria-label="Choose an image">
      {
        highlights.map((highlight, index) => (
          <button
            type="button"
            class:list={['carousel-dot', { 'is-active': index === 0 }]}
            data-carousel-dot
            aria-label={`Show image ${index + 1}: ${highlight.title}`}
            aria-controls={`highlight-${highlight.id}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
          />
        ))
      }
    </div>
    <button
      type="button"
      class="carousel-button"
      data-carousel-toggle
      aria-label="Pause automatic rotation"
    >
      <span aria-hidden="true" data-carousel-toggle-icon>Ⅱ</span>
      <span class="visually-hidden" data-carousel-toggle-label>Pause</span>
    </button>
    <button type="button" class="carousel-button" data-carousel-next aria-label="Show next image">
      <span aria-hidden="true">→</span>
    </button>
    <p class="visually-hidden" data-carousel-status aria-live="off">1 / {highlights.length}</p>
  </div>
</div>

<script>
  const carouselWindow = window as Window & { __cmggCarouselInit?: () => void };

  if (!carouselWindow.__cmggCarouselInit) {
    carouselWindow.__cmggCarouselInit = () => {
      document.querySelectorAll<HTMLElement>('[data-highlights-carousel]').forEach((carousel) => {
        if (carousel.dataset.enhanced === 'true') return;

        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-highlight-slide]'));
        const dots = Array.from(
          carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'),
        );
        const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
        const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
        const toggle = carousel.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
        const toggleIcon = carousel.querySelector<HTMLElement>('[data-carousel-toggle-icon]');
        const toggleLabel = carousel.querySelector<HTMLElement>('[data-carousel-toggle-label]');
        const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');

        if (
          slides.length < 2 ||
          dots.length !== slides.length ||
          !previous ||
          !next ||
          !toggle ||
          !toggleIcon ||
          !toggleLabel
        ) {
          return;
        }

        const controller = new AbortController();
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const interval = Number(carousel.dataset.interval) || 2000;
        let activeIndex = 0;
        let timer: number | undefined;
        let userPaused = false;
        let destroyed = false;

        const stopTimer = () => {
          if (timer !== undefined) window.clearTimeout(timer);
          timer = undefined;
        };

        const render = () => {
          slides.forEach((slide, index) => {
            const isActive = index === activeIndex;
            slide.classList.toggle('is-active', isActive);
            slide.setAttribute('aria-hidden', String(!isActive));
          });

          dots.forEach((dot, index) => {
            const isActive = index === activeIndex;
            dot.classList.toggle('is-active', isActive);
            dot.setAttribute('aria-pressed', String(isActive));
          });

          if (status) status.textContent = `${activeIndex + 1} / ${slides.length}`;
        };

        const scheduleNext = () => {
          stopTimer();
          if (destroyed || reducedMotion.matches || userPaused) return;

          timer = window.setTimeout(() => {
            activeIndex = (activeIndex + 1) % slides.length;
            render();
            scheduleNext();
          }, interval);
        };

        const updateToggle = () => {
          if (reducedMotion.matches) {
            toggle.disabled = true;
            toggleIcon.textContent = '—';
            toggleLabel.textContent = 'Rotation off';
            toggle.setAttribute(
              'aria-label',
              'Automatic rotation is disabled by reduced-motion settings',
            );
            return;
          }

          toggle.disabled = false;
          toggleIcon.textContent = userPaused ? '▶' : 'Ⅱ';
          toggleLabel.textContent = userPaused ? 'Play' : 'Pause';
          toggle.setAttribute(
            'aria-label',
            userPaused ? 'Play automatic rotation' : 'Pause automatic rotation',
          );
        };

        const show = (index: number) => {
          activeIndex = (index + slides.length) % slides.length;
          render();
          scheduleNext();
        };

        const destroy = () => {
          destroyed = true;
          stopTimer();
          controller.abort();
          delete carousel.dataset.enhanced;
        };

        carousel.dataset.enhanced = 'true';
        render();
        updateToggle();
        scheduleNext();

        previous.addEventListener('click', () => show(activeIndex - 1), {
          signal: controller.signal,
        });
        next.addEventListener('click', () => show(activeIndex + 1), {
          signal: controller.signal,
        });
        dots.forEach((dot, index) =>
          dot.addEventListener('click', () => show(index), { signal: controller.signal }),
        );

        toggle.addEventListener(
          'click',
          () => {
            userPaused = !userPaused;
            updateToggle();
            scheduleNext();
          },
          { signal: controller.signal },
        );

        carousel.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              show(activeIndex - 1);
            }
            if (event.key === 'ArrowRight') {
              event.preventDefault();
              show(activeIndex + 1);
            }
            if (event.key === 'Home') {
              event.preventDefault();
              show(0);
            }
            if (event.key === 'End') {
              event.preventDefault();
              show(slides.length - 1);
            }
          },
          { signal: controller.signal },
        );

        reducedMotion.addEventListener(
          'change',
          () => {
            updateToggle();
            scheduleNext();
          },
          { signal: controller.signal },
        );
        document.addEventListener('astro:before-swap', destroy, {
          once: true,
          signal: controller.signal,
        });
      });
    };

    document.addEventListener('astro:page-load', carouselWindow.__cmggCarouselInit);
  }

  carouselWindow.__cmggCarouselInit();
</script>
