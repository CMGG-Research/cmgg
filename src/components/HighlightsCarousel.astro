---
import { HIGHLIGHT_INTERVAL_MS, highlights } from '../data/highlights';
import { withBase } from '../lib/paths';
---

<section class="section section--highlights" aria-labelledby="highlights-heading">
  <div class="container">
    <div class="highlights-heading">
      <div>
        <p class="eyebrow">Highlights</p>
        <h2 id="highlights-heading">Research across scales and methods.</h2>
      </div>
      <p>
        Current projects connect mathematical analysis, computation, and the dynamics of planetary
        interiors.
      </p>
    </div>

    <div
      class="highlights-carousel"
      data-highlights-carousel
      data-interval={HIGHLIGHT_INTERVAL_MS}
      role="region"
      aria-roledescription="carousel"
      aria-label="Research highlights"
    >
      <div class="highlights-carousel__slides" aria-live="off">
        {
          highlights.map((highlight, index) => (
            <article
              class:list={['highlight-slide', { 'is-active': index === 0 }]}
              data-highlight-slide
              id={`highlight-${highlight.id}`}
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${highlights.length}`}
            >
              <div class="highlight-slide__media">
                <img
                  src={withBase(highlight.image)}
                  width={highlight.imageWidth}
                  height={highlight.imageHeight}
                  alt={highlight.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="highlight-slide__content">
                <p class="eyebrow">{highlight.eyebrow}</p>
                <h3>{highlight.title}</h3>
                <p>{highlight.summary}</p>
                <a class="text-link" href={withBase(highlight.href)}>
                  {highlight.linkLabel} →
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="highlights-carousel__controls" role="group" aria-label="Highlight controls">
        <div class="highlights-carousel__buttons">
          <button type="button" class="carousel-button" data-carousel-previous>
            <span aria-hidden="true">←</span><span>Previous</span>
          </button>
          <button type="button" class="carousel-button" data-carousel-toggle>
            <span aria-hidden="true" data-carousel-toggle-icon>Ⅱ</span>
            <span data-carousel-toggle-label>Pause</span>
          </button>
          <button type="button" class="carousel-button" data-carousel-next>
            <span>Next</span><span aria-hidden="true">→</span>
          </button>
        </div>
        <div class="carousel-dots" role="group" aria-label="Choose a highlight">
          {
            highlights.map((highlight, index) => (
              <button
                type="button"
                class:list={['carousel-dot', { 'is-active': index === 0 }]}
                data-carousel-dot
                aria-label={`Show highlight ${index + 1}: ${highlight.title}`}
                aria-controls={`highlight-${highlight.id}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
        <p class="carousel-status" data-carousel-status aria-live="off">
          1 / {highlights.length}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-highlights-carousel]');

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-highlight-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const toggle = carousel.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
    const toggleIcon = carousel.querySelector<HTMLElement>('[data-carousel-toggle-icon]');
    const toggleLabel = carousel.querySelector<HTMLElement>('[data-carousel-toggle-label]');
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');

    if (slides.length < 2 || !previous || !next || !toggle || !toggleIcon || !toggleLabel) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const interval = Number(carousel.dataset.interval) || 5000;
    let activeIndex = 0;
    let timer: number | undefined;
    let userPaused = reducedMotion.matches;
    let pointerPaused = false;
    let focusPaused = false;

    const render = () => {
      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.hidden = !isActive;
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-pressed', String(isActive));
      });

      if (status) status.textContent = `${activeIndex + 1} / ${slides.length}`;
    };

    const stopTimer = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const canRotate = () => !reducedMotion.matches && !userPaused && !pointerPaused && !focusPaused;

    const startTimer = () => {
      stopTimer();
      if (!canRotate()) return;
      timer = window.setInterval(() => {
        activeIndex = (activeIndex + 1) % slides.length;
        render();
      }, interval);
    };

    const updateToggle = () => {
      if (reducedMotion.matches) {
        toggle.disabled = true;
        toggleIcon.textContent = '—';
        toggleLabel.textContent = 'Rotation off';
        toggle.setAttribute(
          'aria-label',
          'Automatic rotation is disabled by reduced-motion settings',
        );
        return;
      }

      toggle.disabled = false;
      toggleIcon.textContent = userPaused ? '▶' : 'Ⅱ';
      toggleLabel.textContent = userPaused ? 'Play' : 'Pause';
      toggle.setAttribute(
        'aria-label',
        userPaused ? 'Play automatic rotation' : 'Pause automatic rotation',
      );
    };

    const show = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      render();
      startTimer();
    };

    carousel.dataset.enhanced = 'true';
    render();
    updateToggle();
    startTimer();

    previous.addEventListener('click', () => show(activeIndex - 1));
    next.addEventListener('click', () => show(activeIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      updateToggle();
      startTimer();
    });

    carousel.addEventListener('pointerenter', () => {
      pointerPaused = true;
      stopTimer();
    });
    carousel.addEventListener('pointerleave', () => {
      pointerPaused = false;
      startTimer();
    });
    carousel.addEventListener('focusin', () => {
      focusPaused = true;
      stopTimer();
    });
    carousel.addEventListener('focusout', (event) => {
      if (carousel.contains(event.relatedTarget as Node | null)) return;
      focusPaused = false;
      startTimer();
    });
    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(activeIndex + 1);
      }
      if (event.key === 'Home') {
        event.preventDefault();
        show(0);
      }
      if (event.key === 'End') {
        event.preventDefault();
        show(slides.length - 1);
      }
    });

    reducedMotion.addEventListener('change', () => {
      userPaused = reducedMotion.matches;
      updateToggle();
      startTimer();
    });
  });
</script>
