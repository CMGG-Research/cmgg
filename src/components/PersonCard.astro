---
import type { Person } from '../data/people';
import { withBase } from '../lib/paths';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const profilePath = withBase(`/people/${person.slug}/`);
const cardMeta = [person.institution, person.status].filter(Boolean).join(' · ');
---

<a class="person-card" href={profilePath} aria-label={`View ${person.name}'s profile`}>
  <span class="person-card__portrait">
    <img
      src={withBase(person.portrait)}
      alt={person.portraitAlt}
      width="800"
      height="1000"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="person-card__body">
    <span class="person-card__category">{person.category}</span>
    <span class="person-card__name">{person.name}</span>
    <span class="person-card__role">{person.cardRole}</span>
    {cardMeta && <span class="person-card__meta">{cardMeta}</span>}
  </span>
</a>
