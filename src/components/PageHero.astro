---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  indexLabel?: string;
}

const { eyebrow, title, intro, indexLabel } = Astro.props;
---

<header class="page-hero">
  <div class="container page-hero__inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="page-hero__intro">{intro}</p>
    </div>
    {indexLabel && <p class="page-hero__index">{indexLabel}</p>}
  </div>
</header>
